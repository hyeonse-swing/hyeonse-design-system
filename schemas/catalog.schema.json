{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hyeonse:design-system:catalog:1",
  "title": "Hyeonse Design System catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "boundaries", "setup", "modules", "entries", "tokens", "examples"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false, "required": ["provided", "notProvided"],
      "properties": { "provided": { "$ref": "#/$defs/strings" }, "notProvided": { "$ref": "#/$defs/strings" } }
    },
    "setup": { "$ref": "#/$defs/strings" },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "tokens": { "type": "array", "items": { "$ref": "#/$defs/token" } },
    "examples": { "type": "array", "items": { "$ref": "#/$defs/example" } }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } },
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["subpath", "importPath", "source", "declarations", "exports"],
      "properties": {
        "subpath": { "type": "string", "minLength": 1 },
        "importPath": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "declarations": { "type": "string", "minLength": 1 },
        "exports": { "type": "array", "items": { "$ref": "#/$defs/export" } }
      }
    },
    "export": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind", "signature"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["value", "type"] },
        "signature": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "summary", "importPath", "source", "signature", "usage", "states", "accessibility", "limitations", "examples", "keywords"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["component", "provider", "hook", "utility"] },
        "summary": { "type": "string", "minLength": 1 },
        "importPath": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "props": { "type": "array", "items": { "$ref": "#/$defs/prop" } },
        "usage": { "$ref": "#/$defs/strings" },
        "states": { "$ref": "#/$defs/strings" },
        "accessibility": { "$ref": "#/$defs/strings" },
        "limitations": { "$ref": "#/$defs/strings" },
        "examples": { "$ref": "#/$defs/strings" },
        "keywords": { "$ref": "#/$defs/strings" }
      }
    },
    "prop": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "token": {
      "type": "object", "additionalProperties": false, "required": ["name", "role", "value", "overrides"],
      "properties": {
        "name": { "type": "string", "pattern": "^--[a-z][a-z0-9-]*$" },
        "role": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "overrides": { "type": "array", "items": { "$ref": "#/$defs/override" } }
      }
    },
    "override": {
      "type": "object", "additionalProperties": false, "required": ["selector", "media", "value"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "media": { "type": ["string", "null"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "example": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "files"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/exampleFile" } }
      }
    },
    "exampleFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "language", "code"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "language": { "enum": ["typescript", "tsx", "css", "html"] },
        "code": { "type": "string" }
      }
    }
  }
}
